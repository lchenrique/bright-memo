{
  "name": "bright-memo-v2",
  "private": true,
  "version": "0.1.0",
  "description": "Bright Memo v2 monorepo",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "packageManager": "pnpm@11.0.0-beta.2",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "format": "prettier --write .",
    "prepare": "husky",
    "db:up": "docker compose -f docker/docker-compose.yml up -d",
    "db:down": "docker compose -f docker/docker-compose.yml down",
    "db:logs": "docker compose -f docker/docker-compose.yml logs -f db",
    "db:psql": "docker compose -f docker/docker-compose.yml exec db psql -U bright -d bright_memo",
    "db:migrate": "pnpm --filter @bright-memo/api drizzle-kit migrate",
    "db:reset": "tsx scripts/db-reset.ts",
    "db:bootstrap": "tsx scripts/db-bootstrap.ts"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.1.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@eslint/js": "^9.31.0",
    "@node-rs/argon2": "^2.0.2",
    "eslint": "^9.31.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.2",
    "prettier": "^3.6.2",
    "tsx": "^4.23.1",
    "turbo": "^2.5.5",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.37.0"
  }
}

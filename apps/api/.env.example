# Server
NODE_ENV=development
LOG_LEVEL=info
PORT=3001

# Comma-separated list of allowed CORS origins. The web client runs at
# APP_URL when developing.
APP_URL=http://localhost:5173

# Postgres connections. DATABASE_URL is for migrations/admin tooling.
# App role has RLS enforced; service role is only for auth/bootstrap.
DATABASE_URL=postgres://bright:changeme@localhost:5432/bright_memo
APP_DATABASE_URL=postgres://bright_app:changeme@localhost:5432/bright_memo
SERVICE_DATABASE_URL=postgres://bright_service:changeme@localhost:5432/bright_memo

# OpenAI — required by embeddings/chat routes (not used in this batch).
OPENAI_API_KEY=sk-replace-me

# Secret used to mint the very first API key without an existing key.
# In dev, generate one with `openssl rand -hex 32` and paste it here.
# In production, pull from a secret manager.
BOOTSTRAP_TOKEN_SECRET=dev-bootstrap-replace-me

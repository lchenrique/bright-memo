# Server
NODE_ENV=development
LOG_LEVEL=info
PORT=3001

# Comma-separated list of allowed CORS origins.
APP_URL=http://localhost:5173

# Replace every password placeholder. DATABASE_URL is migration/admin only.
# bright_app has RLS enforced; bright_service is limited to auth/bootstrap.
DATABASE_URL=postgres://bright:REPLACE_ADMIN_PASSWORD@localhost:5432/bright_memo
APP_DATABASE_URL=postgres://bright_app:REPLACE_APP_PASSWORD@localhost:5432/bright_memo
SERVICE_DATABASE_URL=postgres://bright_service:REPLACE_SERVICE_PASSWORD@localhost:5432/bright_memo

# Optional. Enables hybrid ranking; lexical search works without it.
# OPENAI_API_KEY=REPLACE_OPENAI_KEY_IF_USED

# Secret used to mint the very first API key without an existing key.
# Generate a unique random value of at least 32 characters.
BOOTSTRAP_TOKEN_SECRET=REPLACE_WITH_RANDOM_32_PLUS_CHARACTER_SECRET

# Postgres password for the `bright` superuser
DB_PASS=changeme

# Optional: separate password for the `bright_service` role used by bootstrap
# Falls back to DB_PASS if unset
# SERVICE_DB_PASS=changeme

# Connection strings (defaults shown)
DATABASE_URL=postgres://bright:changeme@localhost:5432/bright_memo
SERVICE_DATABASE_URL=postgres://bright_service:changeme@localhost:5432/bright_memo